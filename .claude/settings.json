{
  "$schema": "https://json.schemastore.org/partial-claude-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(cargo check*)",
      "Bash(cargo test*)",
      "Bash(cargo clippy*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(betterleaks git*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(npm publish*)",
      "Bash(cargo publish*)"
    ]
  },
  "env": {
    "NODE_ENV": "development",
    "RUST_BACKTRACE": "1"
  }
}
