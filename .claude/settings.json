{
  "$schema": "https://json.schemastore.org/partial-claude-settings.json",
  "permissions": {
    "allow": [
      "pnpm test",
      "pnpm build",
      "pnpm typecheck",
      "pnpm lint",
      "cargo check",
      "cargo test",
      "git status",
      "git diff",
      "git log",
      "betterleaks scan"
    ],
    "deny": [
      "rm -rf /",
      "rm -rf ~",
      "git push --force",
      "npm publish",
      "cargo publish"
    ]
  },
  "env": {
    "NODE_ENV": "development",
    "RUST_BACKTRACE": "1"
  }
}
